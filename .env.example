# ==============================================================================
# PropBot Pro - Environment Configuration (.env.example)
# ==============================================================================

# Application & Environment
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://propbot:propbot_password@localhost:5432/propbot_pro?sslmode=disable
DB_MAX_CONNECTIONS=20

# Redis & BullMQ
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=propbot_queue

# Authentication & Secrets (Generate high-entropy strings in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Logging & Monitoring
LOG_LEVEL=debug
SENTRY_DSN=

# AI Provider Keys (Stubbed for future phases)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Integrations (Stubbed for future phases)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
