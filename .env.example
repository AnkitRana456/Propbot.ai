# ==============================================================================
# PropBot Pro - Environment Configuration Template (.env.example)
# Safe placeholder values only. Never commit real keys or secrets.
# Use `pnpm setup:keys` to interactively configure your local environment.
# ==============================================================================

# Application & Environment
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://propbot:propbot_password@localhost:5432/propbot_pro?sslmode=disable
DB_MAX_CONNECTIONS=20

# Redis & BullMQ
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=propbot_queue

# Authentication & Secrets (Generated via pnpm setup:keys)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_for_aes_256_gcm_vault

# Logging & Monitoring
LOG_LEVEL=info
SENTRY_DSN=

# AI & LLM Provider Keys (At least one required for Phase R1 live AI)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# gemini (default) | openai | anthropic
LLM_PROVIDER=gemini
EMBEDDING_API_KEY=
ALLOW_OFFLINE_MOCK=false

# Observability & Tracing (Optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Meta WhatsApp Cloud API (Phase 6 / 18)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Cloudflare R2 / AWS S3 Object Storage (Phase 5 / 19)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=propbot-pro-assets
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Outbound Email Service / SMTP (Phase 8 / 15)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@propbotpro.com

# Payment Gateway (Phase 12 / 24)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Auth & seeding
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Demo data seed password (required in production; dev falls back to a local default)
SEED_DEMO_PASSWORD=
# New company signups need admin approval unless this is true (defaults true only in tests)
SIGNUP_AUTO_APPROVE=false
# Login/register attempts per 15 minutes per IP
AUTH_RATE_LIMIT_MAX=5
# Number of reverse-proxy hops to trust for client IP (0 = none)
TRUSTED_PROXY_HOPS=0

# SMS OTP (Twilio). Without these, dev mode prints the SMS to the server console; production returns 503
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# or use a Messaging Service instead of a from-number
TWILIO_MESSAGING_SERVICE_SID=
# HMAC key for stored OTP hashes (falls back to JWT_ACCESS_SECRET)
OTP_HASH_SECRET=
OTP_RATE_LIMIT_MAX=10

# Shared secret for cron/maintenance endpoints (Authorization: Bearer <secret>)
CRON_SECRET=

# Outbound webhook delivery (per-attempt timeout, ms)
WEBHOOK_TIMEOUT_MS=30000

# WhatsApp Cloud API
# Graph API version used for outbound sends (Meta retires old versions)
META_GRAPH_API_VERSION=v21.0
# App secret used to verify X-Hub-Signature-256 when a company has none of its own. Unsigned deliveries are rejected.
META_APP_SECRET=

# Rate limits (per minute unless noted). Spec defaults shown; limits are in-memory per process
CHAT_RATE_LIMIT_MAX=100
UPLOAD_RATE_LIMIT_MAX=10
GENERAL_RATE_LIMIT_MAX=60
# Signed-in dashboard traffic (the SPA polls, so 60/min would lock it out)
API_AUTH_RATE_LIMIT_MAX=600

# Payments. Webhooks are rejected unless the matching secret is set; use Stripe TEST keys until go-live
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET=
