{
  "name": "@propbot/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --build",
    "test": "vitest run --test-timeout=15000",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:admin": "tsx src/db/seed-admin.ts",
    "check:gemini": "tsx scripts/check-gemini.ts",
    "seed:demo": "tsx src/db/seed-demo.ts",
    "db:push": "drizzle-kit push",
    "doctor": "tsx src/scripts/doctor.ts",
    "smoke:chat": "tsx src/scripts/smoke-chat.ts",
    "setup:keys": "tsx src/scripts/setup-keys.ts",
    "eval": "tsx evals/run-eval.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@langchain/anthropic": "^1.5.12",
    "@langchain/core": "^1.2.18",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/openai": "^1.6.2",
    "@langchain/textsplitters": "^1.0.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@propbot/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.3",
    "express": "^4.19.2",
    "geoip-lite": "^2.0.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.1.7",
    "pdf-parse": "^2.4.5",
    "pino": "^9.2.0",
    "pino-http": "^10.2.0",
    "postgres": "^3.4.9",
    "ua-parser-js": "^2.0.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^8.0.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.2",
    "@types/ua-parser-js": "^0.7.39",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^11.2.1",
    "supertest": "^7.0.0",
    "tsup": "^8.2.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.4"
  }
}
