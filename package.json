{
  "name": "propbot-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @propbot/api dev",
    "dev:worker": "pnpm --filter @propbot/api dev:worker",
    "dev:web": "pnpm --filter @propbot/web dev",
    "dev:widget": "pnpm --filter @propbot/widget dev",
    "seed": "pnpm --filter @propbot/api db:seed",
    "build": "pnpm --recursive run build",
    "typecheck": "tsc --build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "test": "pnpm --recursive run test",
    "test:coverage": "vitest run --coverage",
    "test:load": "tsx apps/api/tests/load/chat-load-test.ts",
    "seed:demo": "pnpm --filter @propbot/api seed:demo",
    "eval": "pnpm --filter @propbot/api eval",
    "prepare": "husky"
  },
  "pnpm": {
    "overrides": {
      "tinypool": ">=2.1.2",
      "vite": "^5.4.14"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@types/node": "^20.14.10",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.1",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.3",
    "tsup": "^8.2.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.4"
  }
}
