{
  "name": "@propbot/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./phone": {
      "import": "./dist/phone.js",
      "types": "./dist/utils/phone.d.ts",
      "default": "./dist/phone.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc -b --force",
    "dev": "tsup --watch",
    "typecheck": "tsc --build --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsup": "^8.2.3",
    "typescript": "^5.5.4",
    "vitest": "^2.0.4"
  }
}
