{
  "name": "@propbot/widget",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/widget.js",
  "module": "./dist/widget.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/widget.js",
